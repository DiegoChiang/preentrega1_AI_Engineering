# Proveedor principal: openai o anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos configurables
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Parámetros de generación
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# RAG local
DATA_DIR=data
CHROMA_PERSIST_DIR=vectorstore
CHROMA_COLLECTION=incident-knowledge
RAG_TOP_K=4
RAG_MIN_RELEVANCE_SCORE=0.30
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

